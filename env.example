"""Проверки без Telegram: разбор дат, форматирование, хранилище, обработчики на подставных объектах.

Запуск из папки проекта:  python -m unittest discover -s tests -v
"""
import asyncio
import os
import sys
import tempfile
import time
import unittest
from datetime import datetime, timedelta
from pathlib import Path
from types import SimpleNamespace
from zoneinfo import ZoneInfo

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from telethon.tl.types import PeerUser, User  # noqa: E402

import bot  # noqa: E402
import texts  # noqa: E402
from settings import Settings  # noqa: E402
from storage import Storage  # noqa: E402
from timeparse import parse_when  # noqa: E402

TZ = ZoneInfo("Europe/Moscow")
NOW = datetime(2026, 11, 11, 3, 43, tzinfo=TZ)  # среда


def dt(*a):
    return datetime(*a, tzinfo=TZ)


def btn_data(button) -> bytes:
    """callback-данные кнопки (в разных версиях Telethon лежат в разных местах)."""
    data = getattr(button, "data", None)
    return data if data is not None else button.type.data


class TimeParseTests(unittest.TestCase):
    def check(self, text, expected, rest=""):
        got, got_rest = parse_when(text, NOW)
        self.assertEqual(got, expected, text)
        self.assertEqual(got_rest, rest, text)

    def test_formats(self):
        self.check("25.12 18:30", dt(2026, 12, 25, 18, 30))
        self.check("завтра в 9:00", dt(2026, 11, 12, 9, 0))
        self.check("через 2 часа", dt(2026, 11, 11, 5, 43))
        self.check("15.01.2027", dt(2027, 1, 15, 9, 0))
        self.check("15.01.27 8:15", dt(2027, 1, 15, 8, 15))
        self.check("послезавтра 18.30", dt(2026, 11, 13, 18, 30))
        self.check("через 3 дня в 10:00", dt(2026, 11, 14, 10, 0))
        self.check("2027-01-15 07:45", dt(2027, 1, 15, 7, 45))
        self.check("сегодня в 21", dt(2026, 11, 11, 21, 0))
        self.check("через полчаса", dt(2026, 11, 11, 4, 13))
        self.check("через неделю", dt(2026, 11, 18, 9, 0))
        self.check("через 15 мин", dt(2026, 11, 11, 3, 58))

    def test_time_only_picks_next_occurrence(self):
        self.check("18:30", dt(2026, 11, 11, 18, 30))
        self.check("03:00", dt(2026, 11, 12, 3, 0))  # сегодня уже прошло

    def test_past_date_rolls_to_next_year(self):
        self.check("01.11", dt(2027, 11, 1, 9, 0))

    def test_rest_text(self):
        self.check("25.12 18:30 купить подарок", dt(2026, 12, 25, 18, 30), "купить подарок")
        self.check("на 25.12 позвонить маме", dt(2026, 12, 25, 9, 0), "позвонить маме")
        self.check("позвонить маме завтра в 18:00", dt(2026, 11, 12, 18, 0), "позвонить маме")
        self.check("завтра в магазин", dt(2026, 11, 12, 9, 0), "в магазин")

    def test_not_a_date(self):
        for s in ("купить хлеб", "31.02", "", "привет как дела"):
            got, rest = parse_when(s, NOW)
            self.assertIsNone(got, s)
            self.assertEqual(rest, s.strip())

    def test_huge_number_does_not_crash(self):
        got, _ = parse_when("через 999999999999 дней", NOW)
        self.assertIsNone(got)

    def test_custom_default_time(self):
        got, _ = parse_when("завтра", NOW, default_time=(7, 30))
        self.assertEqual(got, dt(2026, 11, 12, 7, 30))


class TextsTests(unittest.TestCase):
    ROW = dict(
        chat_id=10, msg_id=1, sender_id=10, name="Иван <Петров>", username="ivan",
        date_ts=int(dt(2026, 11, 11, 3, 43).timestamp()), orig_text="привет & пока", edits=[],
    )

    def test_card_has_all_fields_and_escapes_html(self):
        card = texts.message_card(self.ROW, TZ)
        self.assertIn("Кто писал:</b> Иван &lt;Петров&gt; (@ivan)", card)
        self.assertIn("11 ноября 2026, среда", card)
        self.assertIn("03:43", card)
        self.assertIn("привет &amp; пока", card)

    def test_append_edit_bolds_only_the_added_part(self):
        row = dict(self.ROW, edits=[dict(
            ts=int(dt(2026, 11, 11, 3, 50).timestamp()),
            old="привет & пока", new="привет & пока, увидимся", sep=False)])
        card = texts.message_card(row, TZ)
        self.assertIn("Изменено на</b> (03:50)", card)
        self.assertIn("привет &amp; пока<b>, увидимся</b>", card)

    def test_non_append_edit_shows_new_text_plain(self):
        row = dict(self.ROW, edits=[dict(
            ts=int(dt(2026, 11, 12, 9, 5).timestamp()), old="привет & пока", new="совсем другое", sep=False)])
        card = texts.message_card(row, TZ)
        self.assertIn("совсем другое</blockquote>", card)
        self.assertNotIn("<b>совсем", card)
        self.assertIn("(12.11 09:05)", card)  # правка в другой день — с датой

    def test_cards_parse_with_telethon_html(self):
        from telethon.extensions import html as thtml
        row = dict(self.ROW, edits=[dict(
            ts=int(dt(2026, 11, 11, 3, 50).timestamp()),
            old="привет & пока", new="привет & пока, увидимся", sep=False)])
        plain, entities = thtml.parse(texts.message_card(row, TZ))
        self.assertIn("увидимся", plain)
        self.assertTrue(entities)


class StorageTests(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.db = Storage(Path(self.tmp.name) / "t.db")

    def tearDown(self):
        self.db.close()
        self.tmp.cleanup()

    def test_people_and_settings(self):
        self.assertFalse(self.db.is_person(5))
        self.db.add_person(5, "Аня", None)
        self.assertTrue(self.db.is_person(5))
        self.db.remove_person(5)
        self.assertFalse(self.db.is_person(5))
        self.assertEqual(self.db.get_setting("mode", "selected"), "selected")
        self.db.set_setting("mode", "all")
        self.assertEqual(self.db.get_setting("mode"), "all")

    def test_goals(self):
        a = self.db.add_goal("позже", 2000)
        b = self.db.add_goal("раньше", 1000)
        self.assertEqual([g["title"] for g in self.db.list_goals()], ["раньше", "позже"])
        self.assertEqual([g["id"] for g in self.db.due_goals(1500)], [b])
        self.db.mark_goal_fired(b)
        self.assertEqual(self.db.due_goals(1500), [])
        self.db.delete_goal(a)
        self.assertEqual(self.db.list_goals(), [])

    def test_notes_newest_first(self):
        self.db.add_note("первая")
        n2 = self.db.add_note("вторая")
        self.assertEqual(self.db.list_notes()[0]["id"], n2)
        self.assertEqual(self.db.count_notes(), 2)
        self.db.delete_note(n2)
        self.assertEqual(self.db.count_notes(), 1)

    def test_purge_old_messages(self):
        old = int(time.time()) - 40 * 86400
        self.db.save_message(chat_id=1, msg_id=1, bot_msg_id=1, sender_id=1, name="a", username=None,
                             date_ts=old, text="x")
        self.db.save_message(chat_id=1, msg_id=2, bot_msg_id=2, sender_id=1, name="a", username=None,
                             date_ts=int(time.time()), text="y")
        self.db.purge_old_messages()
        self.assertIsNone(self.db.get_message(1, 1))
        self.assertIsNotNone(self.db.get_message(1, 2))


# ---------------------- подставные объекты Telegram ----------------------
class FakeBot:
    def __init__(self):
        self.sent, self.edited, self._id = [], [], 100

    async def send_message(self, to, text, **kw):
        self._id += 1
        self.sent.append(dict(to=to, text=text, id=self._id, **kw))
        return SimpleNamespace(id=self._id)

    async def edit_message(self, to, msg_id, text, **kw):
        self.edited.append(dict(to=to, id=msg_id, text=text, **kw))


class FakeUser:
    def __init__(self, known):
        self.known = known  # {"@ivan": User}

    async def get_entity(self, key):
        if key in self.known:
            return self.known[key]
        raise ValueError("not found")

    async def get_dialogs(self, limit=0):
        return []

    async def iter_dialogs(self, limit=0):
        for e in self.known.values():
            yield SimpleNamespace(entity=e)


class FakeMsgEvent:
    def __init__(self, sender_id, message, chat_id=None, sender=None):
        self.sender_id = sender_id
        self.chat_id = chat_id or sender_id
        self.message = message
        self._sender = sender

    async def get_sender(self):
        return self._sender


def tg_msg(msg_id, text, when=None, edit_date=None, **extra):
    return SimpleNamespace(
        id=msg_id, message=text, date=when or dt(2026, 11, 11, 3, 43), edit_date=edit_date, **extra
    )


class FakeChatEvent:
    """Событие для меню/текста от владельца."""

    def __init__(self, sender_id, text="", data=None, fwd_from=None):
        self.sender_id = sender_id
        self.raw_text = text
        self.data = data.encode() if data else None
        self.message = SimpleNamespace(fwd_from=fwd_from)
        self.responses, self.edits, self.answers = [], [], 0

    async def respond(self, text, **kw):
        self.responses.append((text, kw))

    async def edit(self, text, **kw):
        self.edits.append((text, kw))

    async def answer(self, *a, **kw):
        self.answers += 1


OWNER, BOT_ID, IVAN = 1, 2, 555


class BotTestBase(unittest.IsolatedAsyncioTestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        bot.ctx.cfg = Settings(
            api_id=1, api_hash="x", bot_token="t", tz=TZ, default_time=(9, 0),
            data_dir=Path(self.tmp.name), notify_on_start=False,
        )
        bot.ctx.db = Storage(Path(self.tmp.name) / "bot.db")
        bot.ctx.bot = FakeBot()
        self.ivan = User(id=IVAN, first_name="Иван", last_name="Петров", username="ivan")
        bot.ctx.user = FakeUser({"ivan": self.ivan, "@ivan": self.ivan, IVAN: self.ivan})
        bot.ctx.owner_id, bot.ctx.bot_id, bot.ctx.state = OWNER, BOT_ID, None
        bot.ctx.ready = asyncio.Event()
        bot.ctx.ready.set()

    def tearDown(self):
        bot.ctx.db.close()
        self.tmp.cleanup()


class IncomingTests(BotTestBase):
    async def new(self, sender_id=IVAN, text="привет", sender=None, msg_id=1, **extra):
        await bot.on_new_message(
            FakeMsgEvent(sender_id, tg_msg(msg_id, text, **extra), sender=sender or self.ivan)
        )

    async def test_whitelisted_sender_is_forwarded_in_card_format(self):
        bot.ctx.db.add_person(IVAN, "Иван Петров", "ivan")
        await self.new(text="привет, ты тут?")
        self.assertEqual(len(bot.ctx.bot.sent), 1)
        sent = bot.ctx.bot.sent[0]
        self.assertEqual(sent["to"], OWNER)
        for part in ("Кто писал:</b> Иван Петров (@ivan)", "11 ноября 2026, среда", "03:43", "привет, ты тут?"):
            self.assertIn(part, sent["text"])
        self.assertIsNotNone(bot.ctx.db.get_message(IVAN, 1))

    async def test_unknown_sender_ignored_in_selected_mode(self):
        await self.new()
        self.assertEqual(bot.ctx.bot.sent, [])

    async def test_all_mode_forwards_everyone_but_skips_bots_and_service(self):
        bot.ctx.db.set_setting("mode", "all")
        await self.new()
        self.assertEqual(len(bot.ctx.bot.sent), 1)
        await self.new(sender_id=777000, msg_id=2)  # коды входа Telegram
        await self.new(sender_id=BOT_ID, msg_id=3)  # наш же бот — иначе петля
        await self.new(sender_id=OWNER, msg_id=4)
        other_bot = User(id=900, first_name="SomeBot", bot=True)
        await self.new(sender_id=900, sender=other_bot, msg_id=5)
        self.assertEqual(len(bot.ctx.bot.sent), 1)

    async def test_own_bot_never_forwarded_even_if_whitelisted(self):
        bot.ctx.db.add_person(BOT_ID, "bot", None)
        await self.new(sender_id=BOT_ID)
        self.assertEqual(bot.ctx.bot.sent, [])

    async def test_media_description(self):
        bot.ctx.db.add_person(IVAN, "Иван", "ivan")
        await self.new(text="смотри", photo=object())
        self.assertIn("🖼 Фото\nсмотри", bot.ctx.bot.sent[0]["text"])
        await self.new(text="", msg_id=2, voice=object())
        self.assertIn("🎤 Голосовое сообщение", bot.ctx.bot.sent[1]["text"])
        await self.new(text="", msg_id=3, document=object(), file=SimpleNamespace(name="отчёт.pdf", emoji=None))
        self.assertIn("📎 Файл: отчёт.pdf", bot.ctx.bot.sent[2]["text"])

    async def edit(self, text, msg_id=1, edit_date=None):
        await bot.on_edited(
            FakeMsgEvent(IVAN, tg_msg(msg_id, text, edit_date=edit_date or dt(2026, 11, 11, 3, 50)))
        )

    async def test_edit_appends_note_to_original_card(self):
        bot.ctx.db.add_person(IVAN, "Иван Петров", "ivan")
        await self.new(text="встретимся в 5")
        await self.edit("встретимся в 5, у метро")
        self.assertEqual(len(bot.ctx.bot.edited), 1)
        edited = bot.ctx.bot.edited[0]
        self.assertEqual(edited["id"], bot.ctx.bot.sent[0]["id"])  # правим именно исходное уведомление
        self.assertIn("встретимся в 5", edited["text"])
        self.assertIn("Изменено на</b> (03:50)", edited["text"])
        self.assertIn("<b>, у метро</b>", edited["text"])

        await self.edit("совсем другое", edit_date=dt(2026, 11, 11, 4, 1))
        text = bot.ctx.bot.edited[1]["text"]
        self.assertEqual(text.count("Изменено на"), 2)  # обе правки видны
        self.assertIn("совсем другое", text)
        self.assertIn("встретимся в 5", text)  # исходный текст сохранился

    async def test_same_text_or_unknown_message_edit_ignored(self):
        bot.ctx.db.add_person(IVAN, "Иван", "ivan")
        await self.new(text="раз")
        await self.edit("раз")
        await self.edit("что-то", msg_id=999)
        self.assertEqual(bot.ctx.bot.edited, [])
        self.assertEqual(len(bot.ctx.bot.sent), 1)

    async def test_edit_that_does_not_fit_goes_as_separate_reply(self):
        bot.ctx.db.add_person(IVAN, "Иван", "ivan")
        await self.new(text="а" * 3000)
        await self.edit("б" * 3000)
        self.assertEqual(bot.ctx.bot.edited, [])
        self.assertEqual(len(bot.ctx.bot.sent), 2)
        self.assertEqual(bot.ctx.bot.sent[1]["reply_to"], bot.ctx.bot.sent[0]["id"])
        self.assertLessEqual(len(bot.ctx.bot.sent[1]["text"]), 4096)
        self.assertIn("Изменено на", bot.ctx.bot.sent[1]["text"])

    async def test_handler_errors_do_not_crash(self):
        bot.ctx.db.add_person(IVAN, "Иван", "ivan")

        async def boom(*a, **k):
            raise ValueError("не нажал /start")

        bot.ctx.bot.send_message = boom
        await self.new()  # исключение только в лог


class MenuTests(BotTestBase):
    async def press(self, data):
        ev = FakeChatEvent(OWNER, data=data)
        await bot.on_callback(ev)
        self.assertEqual(ev.answers, 1)
        return ev.edits[-1] if ev.edits else None

    async def say(self, text, **kw):
        ev = FakeChatEvent(OWNER, text=text, **kw)
        await bot.on_text(ev)
        return ev

    async def test_stranger_is_ignored(self):
        ev = FakeChatEvent(999, text="/start")
        await bot.on_text(ev)
        self.assertEqual(ev.responses, [])
        ev = FakeChatEvent(999, data="g:menu")
        await bot.on_callback(ev)
        self.assertEqual(ev.edits, [])

    async def test_start_shows_main_menu_with_three_buttons(self):
        ev = await self.say("/start")
        text, kw = ev.responses[0]
        self.assertIn("Главное меню", text)
        labels = [b.text for row in kw["buttons"] for b in row]
        self.assertEqual(labels, ["🎯 Цели", "👥 Люди", "📝 Заметки"])

    async def test_goal_flow_date_then_text(self):
        await self.press("g:new")
        self.assertEqual(bot.ctx.state, ("goal_when",))
        ev = await self.say("25.12 18:30")
        self.assertEqual(bot.ctx.state[0], "goal_title")
        self.assertIn("Что напомнить", ev.responses[0][0])
        ev = await self.say("купить подарок")
        self.assertIsNone(bot.ctx.state)
        self.assertIn("Цель добавлена", ev.responses[0][0])
        goals = bot.ctx.db.list_goals()
        self.assertEqual(len(goals), 1)
        self.assertEqual(goals[0]["title"], "купить подарок")
        due = datetime.fromtimestamp(goals[0]["due_ts"], TZ)
        self.assertEqual((due.month, due.day, due.hour, due.minute), (12, 25, 18, 30))

    async def test_goal_flow_one_line_and_errors(self):
        await self.press("g:new")
        ev = await self.say("абракадабра")
        self.assertIn("Не понял дату", ev.responses[0][0])
        self.assertEqual(bot.ctx.state, ("goal_when",))  # остаёмся в режиме ввода
        ev = await self.say("через 2 часа позвонить маме")
        self.assertIsNone(bot.ctx.state)
        self.assertEqual(bot.ctx.db.list_goals()[0]["title"], "позвонить маме")
        # прошедшее время
        await self.press("g:new")
        past = (datetime.now(TZ) - timedelta(days=1)).strftime("%d.%m.%Y 10:00")
        ev = await self.say(past)
        self.assertIn("уже прошло", ev.responses[0][0])
        self.assertEqual(len(bot.ctx.db.list_goals()), 1)

    async def test_goal_delete_and_cancel(self):
        bot.ctx.db.add_goal("x", int(time.time()) + 3600)
        gid = bot.ctx.db.list_goals()[0]["id"]
        await self.press("g:new")
        await self.press("g:menu")  # «Отмена»
        self.assertIsNone(bot.ctx.state)
        await self.press(f"g:del:{gid}")
        self.assertEqual(bot.ctx.db.list_goals(), [])

    async def test_reminder_fires_once_when_due(self):
        due = int(time.time()) - 5
        bot.ctx.db.add_goal("выпить воды", due)
        bot.ctx.db.add_goal("потом", int(time.time()) + 3600)
        self.assertEqual(await bot.fire_due_goals(), 1)
        self.assertEqual(await bot.fire_due_goals(), 0)  # повторно не шлёт
        self.assertEqual(len(bot.ctx.bot.sent), 1)
        self.assertIn("Время пришло", bot.ctx.bot.sent[0]["text"])
        self.assertIn("выпить воды", bot.ctx.bot.sent[0]["text"])
        self.assertNotIn("задержалось", bot.ctx.bot.sent[0]["text"])
        self.assertEqual(len(bot.ctx.db.list_goals()), 1)

    async def test_late_reminder_is_marked_and_failed_send_is_retried(self):
        bot.ctx.db.add_goal("давно", int(time.time()) - 3600)
        real_send = bot.ctx.bot.send_message

        async def fail(*a, **k):
            raise ValueError("нет /start")

        bot.ctx.bot.send_message = fail
        with self.assertRaises(ValueError):
            await bot.fire_due_goals()
        self.assertEqual(len(bot.ctx.db.list_goals()), 1)  # не потеряно
        bot.ctx.bot.send_message = real_send
        self.assertEqual(await bot.fire_due_goals(), 1)
        self.assertIn("задержалось", bot.ctx.bot.sent[0]["text"])

    async def test_people_add_by_username_mode_toggle_and_delete(self):
        await self.press("p:add")
        ev = await self.say("@ivan")
        self.assertTrue(bot.ctx.db.is_person(IVAN))
        self.assertIn("Иван Петров (@ivan)", ev.responses[0][0])
        await self.press("p:mode")
        self.assertEqual(bot.ctx.db.get_setting("mode"), "all")
        await self.press("p:mode")
        self.assertEqual(bot.ctx.db.get_setting("mode"), "selected")
        await self.press(f"p:del:{IVAN}")
        self.assertFalse(bot.ctx.db.is_person(IVAN))

    async def test_people_add_errors_forward_and_recent(self):
        await self.press("p:add")
        ev = await self.say("@nobody")
        self.assertIn("Не нашёл", ev.responses[0][0])
        self.assertEqual(bot.ctx.state, ("person",))
        ev = await self.say("", fwd_from=SimpleNamespace(from_id=None))
        self.assertIn("скрыт", ev.responses[0][0])
        ev = await self.say("", fwd_from=SimpleNamespace(from_id=PeerUser(IVAN)))
        self.assertTrue(bot.ctx.db.is_person(IVAN))
        # недавние чаты: уже добавленного не показываем, выбор по кнопке добавляет
        bot.ctx.db.remove_person(IVAN)
        edit = await self.press("p:recent")
        self.assertIn(f"p:pick:{IVAN}".encode(), [btn_data(b) for row in edit[1]["buttons"] for b in row])
        await self.press(f"p:pick:{IVAN}")
        self.assertTrue(bot.ctx.db.is_person(IVAN))
        self.assertEqual(btn_data((await self.press("p:add"))[1]["buttons"][0][0]), b"p:recent")

    async def test_cannot_add_self_or_own_bot(self):
        me = User(id=OWNER, first_name="Я", username="me")
        bot.ctx.user.known["me"] = me
        await self.press("p:add")
        ev = await self.say("@me")
        self.assertIn("собственный аккаунт", ev.responses[0][0])
        self.assertFalse(bot.ctx.db.is_person(OWNER))

    async def test_notes_flow(self):
        await self.press("n:new")
        ev = await self.say("купить <молоко> & хлеб")
        self.assertEqual(bot.ctx.db.count_notes(), 1)
        self.assertIn("Заметки", ev.responses[0][0])
        nid = bot.ctx.db.list_notes()[0]["id"]
        text, _ = await self.press(f"n:v:{nid}")
        self.assertIn("купить &lt;молоко&gt; &amp; хлеб", text)
        await self.press(f"n:del:{nid}")
        self.assertEqual(bot.ctx.db.count_notes(), 0)

    async def test_plain_text_without_state_shows_menu(self):
        ev = await self.say("что-то написал")
        self.assertIn("Главное меню", ev.responses[0][0])


class StartupTests(unittest.IsolatedAsyncioTestCase):
    async def test_exits_with_code_2_and_touches_nothing_when_not_logged_in(self):
        with tempfile.TemporaryDirectory() as tmp:
            cfg = Settings(api_id=1, api_hash="x", bot_token="t", tz=TZ, default_time=(9, 0),
                           data_dir=Path(tmp), notify_on_start=False)
            self.assertEqual(await asyncio.wait_for(bot.amain(cfg), timeout=5), 2)
            # ни пустой сессии, ни базы: иначе install.sh мог бы принять это за выполненный вход
            self.assertEqual(os.listdir(tmp), [])


if __name__ == "__main__":
    unittest.main()
